name: async-forge

services:
  mysql:
    image: mysql:8.0
    container_name: async-forge-mysql
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:-root}
      MYSQL_DATABASE: ${MYSQL_DATABASE:-async_forge}
      TZ: Asia/Shanghai
    ports:
      - "${MYSQL_PORT:-3306}:3306"
    volumes:
      - mysql_data:/var/lib/mysql
      - ../database/sql/schema.sql:/docker-entrypoint-initdb.d/schema.sql:ro
    command: --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-p${MYSQL_ROOT_PASSWORD:-root}"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - async-forge

  rabbitmq:
    image: rabbitmq:3-management
    container_name: async-forge-rabbitmq
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: ${RABBITMQ_USER:-guest}
      RABBITMQ_DEFAULT_PASS: ${RABBITMQ_PASSWORD:-guest}
    ports:
      - "${RABBITMQ_PORT:-5672}:5672"
      - "${RABBITMQ_MANAGEMENT_PORT:-15672}:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
    networks:
      - async-forge

  backend:
    build:
      context: ../backend
      dockerfile: Dockerfile
    image: async-forge-backend:local
    container_name: async-forge-backend
    restart: unless-stopped
    environment:
      MYSQL_HOST: mysql
      MYSQL_PORT: 3306
      MYSQL_DATABASE: ${MYSQL_DATABASE:-async_forge}
      MYSQL_USER: ${MYSQL_USER:-root}
      MYSQL_PASSWORD: ${MYSQL_PASSWORD:-root}
      RABBITMQ_HOST: rabbitmq
      RABBITMQ_PORT: 5672
      RABBITMQ_USER: ${RABBITMQ_USER:-guest}
      RABBITMQ_PASSWORD: ${RABBITMQ_PASSWORD:-guest}
      JWT_SECRET: ${JWT_SECRET:-change-me-use-at-least-32-characters-long}
      AGENT_BASE_URL: http://agent:8081
      AGENT_TIMEOUT_SECONDS: ${AGENT_TIMEOUT_SECONDS:-60}
      TZ: Asia/Shanghai
    ports:
      - "${BACKEND_PORT:-8090}:8090"
    depends_on:
      mysql:
        condition: service_healthy
      rabbitmq:
        condition: service_healthy
      agent:
        condition: service_healthy
    networks:
      - async-forge

  agent:
    build:
      context: ../agent
      dockerfile: Dockerfile
    image: async-forge-agent:local
    container_name: async-forge-agent
    restart: unless-stopped
    environment:
      AGENT_JSONRPC_URL: http://agent:8081
      AI_BASE_URL: ${AI_BASE_URL:-}
      AI_API_KEY: ${AI_API_KEY:-}
      AI_MODEL: ${AI_MODEL:-}
      TZ: Asia/Shanghai
    ports:
      - "${AGENT_PORT:-8081}:8081"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/health')
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks:
      - async-forge

  frontend:
    build:
      context: ../frontend
      dockerfile: Dockerfile
    image: async-forge-frontend:local
    container_name: async-forge-frontend
    restart: unless-stopped
    ports:
      - "${FRONTEND_PORT:-5173}:80"
    depends_on:
      - backend
    networks:
      - async-forge

volumes:
  mysql_data:
  rabbitmq_data:

networks:
  async-forge:
    driver: bridge
