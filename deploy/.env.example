# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=async_forge
MYSQL_PORT=3306

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# App published ports
BACKEND_PORT=8090
FRONTEND_PORT=5173

# Backend credentials (compose 内 MYSQL_HOST/RABBITMQ_HOST 使用服务名)
MYSQL_USER=root
MYSQL_PASSWORD=root
JWT_SECRET=change-me-use-at-least-32-characters-long

# 本地 mvn / npm 调试时使用（容器内勿用 localhost 连中间件）
MYSQL_HOST=localhost
RABBITMQ_HOST=localhost

# Agent Runtime（Compose 内 backend 必须用 http://agent:8081，勿交给 HTTP_CALL）
AGENT_PORT=8081
AGENT_BASE_URL=http://localhost:8081
AGENT_TIMEOUT_SECONDS=60

# OpenAI-compatible Chat Completions（步骤 C 起必填，forceFail 除外；密钥勿提交）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
